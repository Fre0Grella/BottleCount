{
  "name": "bottlecount",
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "lint": "eslint . --max-warnings 790",
    "lint:fix": "eslint . --fix",
    "check:dupes": "jscpd",
    "check:deps": "depcruise src shared functions backend/src --ignore-known",
    "check:deps:baseline": "depcruise src shared functions backend/src --output-type baseline --output-to .dependency-cruiser-known-violations.json",
    "check:unused": "knip --no-progress",
    "backend": "npm run -w backend",
    "backend:dev": "npm run -w backend dev",
    "backend:test": "npm run -w backend test",
    "test": "vitest run && npm run -w backend test",
    "typecheck": "astro check && npm run -w backend typecheck",
    "test:frontend": "vitest run",
    "build:docs": "BUILD_TARGET=docs BASE_PATH=/BottleCount/ SITE=https://fre0grella.github.io PUBLIC_APP_ORIGIN=https://bottlecount-epj.pages.dev astro build",
    "brand": "node scripts/brand.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/vue": "^6.0.1",
    "astro": "^6.1.10",
    "dexie": "^3.2.7",
    "qr-scanner": "^1.4.2",
    "qrcode": "^1.5.3",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.5",
    "astro-eslint-parser": "^1.4.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-vue": "^10.9.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.2",
    "knip": "^6.42.1",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^5.0.1",
    "vue-eslint-parser": "^10.4.0"
  }
}
