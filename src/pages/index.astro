---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/site/NavBar.astro';
import AppFooter from '../components/site/AppFooter.vue';
import Icon from '../components/ui/Icon.vue';
import { APP_URL } from '../lib/links';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="BottleCount — Throw the party. We'll count the bottles."
  canonical
  bodyClass="landing"
>
  <NavBar />

  <main>
    <!-- ── Hero ── -->
    <section class="hero">
      <div class="shell hero-inner">
        <!-- Floating line-drawing illustrations -->
        <div
          class="float-svg"
          style="--rot:8deg;top:5%;right:33%;opacity:0.9;animation-duration:6s"
        >
          <svg
            width="150"
            height="150"
            viewBox="0 0 80 80"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <defs>
              <linearGradient
                id="bcGrad1"
                x1="0"
                y1="0"
                x2="1"
                y2="1"
                gradientUnits="objectBoundingBox"
              >
                <stop offset="0" stop-color="#FF7A3D"></stop>
                <stop offset="0.5" stop-color="#ffb347"></stop>
                <stop offset="1" stop-color="#FF7A3D"></stop>
              </linearGradient>
              <filter id="bcGlow1" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur
                  in="SourceGraphic"
                  stdDeviation="2.8"
                  result="blur"></feGaussianBlur>
                <feComposite in="SourceGraphic" in2="blur" operator="over"
                ></feComposite>
              </filter>
            </defs>
            <g stroke="url(#bcGrad1)" stroke-width="3.4" filter="url(#bcGlow1)">
              <!-- Martini bowl + stem + foot, one continuous tube -->
              <path
                d="M14 24 Q40 20 66 24
                     L40 50
                     L14 24
                     M40 50 L40 66
                     M27 68 Q40 73 53 68"
              ></path>
              <!-- olive on a pick -->
              <path d="M54 13 L36 39"></path>
              <circle cx="37" cy="38" r="4"></circle>
              <!-- sparkle -->
              <path d="M60 50v6 M57 53h6" opacity="0.7"></path>
            </g>
          </svg>
        </div>
        <div
          class="float-svg float-svg-hero"
          style="--rot:-4deg;top:9%;right:5%;opacity:0.96;animation-duration:8s"
        >
          <svg
            width="212"
            height="352"
            viewBox="0 0 120 200"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
            style="overflow:visible"
          >
            <defs>
              <linearGradient
                id="bcGrad2"
                x1="0"
                y1="0"
                x2="1"
                y2="1"
                gradientUnits="objectBoundingBox"
              >
                <stop offset="0" stop-color="#FF7A3D"></stop>
                <stop offset="0.5" stop-color="#ffb347"></stop>
                <stop offset="1" stop-color="#FF7A3D"></stop>
              </linearGradient>
              <filter id="bcGlow2" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur
                  in="SourceGraphic"
                  stdDeviation="2.6"
                  result="blur"></feGaussianBlur>
                <feComposite in="SourceGraphic" in2="blur" operator="over"
                ></feComposite>
              </filter>
            </defs>
            <g stroke="url(#bcGrad2)" stroke-width="3" filter="url(#bcGlow2)">
              <!-- Tilted bottle, pouring down-left — one continuous neon tube -->
              <g transform="translate(54 90) rotate(-142)">
                <!-- single unbroken outline: cap → left wall → base → right wall -->
                <path
                  d="M5 2 L5 -4 Q5 -6 3 -6 L-3 -6 Q-5 -6 -5 -4 L-5 2
                       L-5 20 C-5.5 28 -14 32 -14 42 C-15 60 -14 82 -13 98
                       Q0 107 13 98
                       C14 82 15 60 14 42 C14 32 5.5 28 5 20 Z"
                ></path>
                <!-- wavy label bands -->
                <path d="M-14 64 Q0 70 14 64"></path>
                <path d="M-13 80 Q0 75 13 80"></path>
              </g>

              <!-- undulating pour stream, one tube -->
              <path d="M50 95 C42 110 60 120 50 134"></path>

              <!-- wine glass — one continuous line: rim → bowl → stem → foot -->
              <path
                d="M31 132 Q50 127 69 132
                     C66 149 55 161 50 163
                     C45 161 34 149 31 132"
              ></path>
              <path d="M50 163 L50 183 M39 185 Q50 189 61 185"></path>
              <!-- wine surface -->
              <path d="M37 139 Q50 145 63 139" opacity="0.8"></path>

              <!-- little splash + sparkles for flair -->
              <path d="M56 124 q3 -3 6 1" opacity="0.85"></path>
              <path d="M20 152 v7 M16.5 155.5 h7" opacity="0.7"></path>
              <path d="M92 30 v6 M89 33 h6" opacity="0.6"></path>
            </g>
          </svg>
        </div>
        <div
          class="float-svg"
          style="--rot:14deg;top:66%;right:31%;opacity:0.7;animation-duration:5.5s"
        >
          <svg
            width="92"
            height="92"
            viewBox="0 0 50 50"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <defs>
              <linearGradient
                id="bcGrad3"
                x1="0"
                y1="0"
                x2="1"
                y2="1"
                gradientUnits="objectBoundingBox"
              >
                <stop offset="0" stop-color="#FF7A3D"></stop>
                <stop offset="0.5" stop-color="#ffb347"></stop>
                <stop offset="1" stop-color="#FF7A3D"></stop>
              </linearGradient>
              <filter id="bcGlow3" x="-50%" y="-50%" width="200%" height="200%">
                <feGaussianBlur
                  in="SourceGraphic"
                  stdDeviation="2.2"
                  result="blur"></feGaussianBlur>
                <feComposite in="SourceGraphic" in2="blur" operator="over"
                ></feComposite>
              </filter>
            </defs>
            <g stroke="url(#bcGrad3)" stroke-width="2.8" filter="url(#bcGlow3)">
              <!-- Champagne flute — one continuous tube: bowl → stem → foot -->
              <path
                d="M19 7 Q25 5 31 7
                     C30 22 27 30 25 35
                     C23 30 20 22 19 7
                     M25 35 L25 44
                     M18 46 Q25 50 32 46"
              ></path>
              <!-- rising bubbles -->
              <circle cx="24" cy="16" r="1.1"></circle>
              <circle cx="26.5" cy="22" r="1"></circle>
              <circle cx="24" cy="27" r="0.9"></circle>
              <!-- fizz sparkle -->
              <path d="M30 4v4 M28 6h4" opacity="0.7"></path>
            </g>
          </svg>
        </div>

        <div class="hero-copy">
          <!-- Badge -->
          <div class="hero-badge">
            <span class="badge-dot"></span>
            For home hosts &amp; small party planners
          </div>

          <!-- H1 -->
          <h1 class="hero-h1">
            Throw the party.<br />We'll count the <span class="gradient-text"
              >bottles</span
            >.
          </h1>

          <!-- Subtitle -->
          <p class="hero-sub">
            Tell BottleCount who's coming and the vibe. It balances your drink
            menu, works out the <strong>exact</strong> shopping list and budget, then
            runs your invites and the door — all in one calm screen.
          </p>

          <!-- CTA buttons -->
          <div class="hero-actions">
            <a class="btn-accent btn-lg" href={APP_URL}>
              Plan a party
              <Icon name="arrowR" size={16} />
            </a>
            <a class="btn-ghost btn-lg" href={`${base}docs`}>
              <Icon name="doc" size={16} />
              How it works
            </a>
          </div>

          <!-- Stats -->
          <div class="hero-stats">
            <div class="stat">
              <span class="stat-val">75 ml</span>
              <span class="stat-label">alcohol / guest model</span>
            </div>
            <div class="stat">
              <span class="stat-val">€ exact</span>
              <span class="stat-label">shopping list &amp; budget</span>
            </div>
            <div class="stat">
              <span class="stat-val">QR door</span>
              <span class="stat-label">check-in built in</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Four steps ── -->
    <section class="steps-section">
      <div class="shell">
        <p class="section-eyebrow">The flow</p>
        <h2 class="section-h2">Four steps, no spreadsheet</h2>
        <div class="steps-grid">
          <!-- Step 1 -->
          <article class="step-card">
            <span class="step-num">1</span>
            <span class="step-chip step-chip--0">
              <Icon name="mapPin" size={20} />
            </span>
            <h3 class="step-title">Set the scene</h3>
            <p class="step-body">
              Name it, pin the venue, pick the date and how hard it goes.
            </p>
          </article>

          <!-- Step 2 -->
          <article class="step-card">
            <span class="step-num">2</span>
            <span class="step-chip step-chip--1">
              <Icon name="glass" size={20} />
            </span>
            <h3 class="step-title">Balance the bar</h3>
            <p class="step-body">
              Drag sliders to mix beer, wine and cocktails. We pour the math.
            </p>
          </article>

          <!-- Step 3 -->
          <article class="step-card">
            <span class="step-num">3</span>
            <span class="step-chip step-chip--2">
              <Icon name="cart" size={20} />
            </span>
            <h3 class="step-title">Shop smart</h3>
            <p class="step-body">
              An exact bottle-by-bottle list with a price range and a buffer.
            </p>
          </article>

          <!-- Step 4 -->
          <article class="step-card">
            <span class="step-num">4</span>
            <span class="step-chip step-chip--3">
              <Icon name="users" size={20} />
            </span>
            <h3 class="step-title">Fill the room</h3>
            <p class="step-body">
              Send invites, watch RSVPs spread, scan tickets at the door.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ── Features ── -->
    <section class="features-section">
      <div class="shell">
        <h2 class="section-h2">Everything a host actually needs</h2>
        <div class="features-grid">
          <!-- Feature 1 -->
          <article class="feat-card">
            <span class="feat-icon">
              <Icon name="glass" size={18} />
            </span>
            <h3 class="feat-title">Auto-balancing menu</h3>
            <p class="feat-body">
              Move one drink and the rest rebalance to 100%. Pin the ones you
              care about.
            </p>
          </article>

          <!-- Feature 2 -->
          <article class="feat-card">
            <span class="feat-icon">
              <Icon name="sparkle" size={18} />
            </span>
            <h3 class="feat-title">Custom cocktails</h3>
            <p class="feat-body">
              Pick classics per spirit or build your own from mixers —
              quantities feed the list.
            </p>
          </article>

          <!-- Feature 3 -->
          <article class="feat-card">
            <span class="feat-icon">
              <Icon name="trend" size={18} />
            </span>
            <h3 class="feat-title">Live budget</h3>
            <p class="feat-body">
              Spend, revenue, profit and the exact break-even headcount, always
              on screen.
            </p>
          </article>

          <!-- Feature 4 -->
          <article class="feat-card">
            <span class="feat-icon">
              <Icon name="users" size={18} />
            </span>
            <h3 class="feat-title">RSVP funnel</h3>
            <p class="feat-body">
              See reached, confirmed and maybes against your capacity at a
              glance.
            </p>
          </article>

          <!-- Feature 5 -->
          <article class="feat-card">
            <span class="feat-icon">
              <Icon name="share" size={18} />
            </span>
            <h3 class="feat-title">Friends invite friends</h3>
            <p class="feat-body">
              Let guests forward the invite and watch how far the word travels.
            </p>
          </article>

          <!-- Feature 6 -->
          <article class="feat-card">
            <span class="feat-icon">
              <Icon name="scan" size={18} />
            </span>
            <h3 class="feat-title">Door scanner</h3>
            <p class="feat-body">
              Every accepted guest gets a QR ticket. Scan them in, no clipboard
              needed.
            </p>
          </article>
        </div>
      </div>
    </section>

    <!-- ── CTA Banner ── -->
    <section class="cta-section">
      <div class="shell">
        <div class="cta-banner">
          <div class="cta-glow"></div>
          <div class="cta-content">
            <h2 class="cta-h2">Your next party, sorted in five minutes.</h2>
            <p class="cta-sub">
              No login needed for the demo — jump in, drag a few sliders, watch
              the numbers land.
            </p>
            <a class="btn-dark btn-lg" href={APP_URL}>
              Open the console
              <Icon name="arrowR" size={16} />
            </a>
          </div>
        </div>

        <p class="tagline">
          BottleCount · a calmer way to host · built for the people who actually
          buy the booze
        </p>
      </div>
    </section>
  </main>
  <AppFooter />
</BaseLayout>

<style>
  /* ── Page background ── */
  :global(body.landing) {
    background:
      radial-gradient(
        120% 80% at 80% -10%,
        rgba(255, 122, 61, 0.16),
        transparent 55%
      ),
      radial-gradient(
        90% 60% at 0% 0%,
        rgba(45, 212, 191, 0.1),
        transparent 50%
      ),
      var(--bg);
    min-height: 100vh;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
  }

  .hero-inner {
    position: relative;
    padding-top: 20px;
    padding-bottom: 40px;
  }

  .float-emoji {
    position: absolute;
    animation: bcFloat var(--dur, 6s) ease-in-out infinite;
    pointer-events: none;
    user-select: none;
    line-height: 1;
  }

  .float-svg {
    position: absolute;
    line-height: 0;
    pointer-events: none;
    user-select: none;
    animation:
      bcFloat var(--dur, 6s) ease-in-out infinite,
      bcGlowPulse var(--dur, 6s) ease-in-out infinite;
    will-change: transform, filter;
    filter: drop-shadow(0 0 6px rgba(255, 122, 61, 0.35))
      drop-shadow(0 10px 30px rgba(255, 122, 61, 0.25));
  }

  @keyframes bcGlowPulse {
    0%,
    100% {
      filter: drop-shadow(0 0 5px rgba(255, 122, 61, 0.3))
        drop-shadow(0 10px 26px rgba(255, 122, 61, 0.2));
    }
    50% {
      filter: drop-shadow(0 0 11px rgba(255, 179, 71, 0.55))
        drop-shadow(0 12px 34px rgba(255, 122, 61, 0.32));
    }
  }

  .hero-copy {
    max-width: 680px;
    position: relative;
    z-index: 1;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 13px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    margin-bottom: 22px;
  }

  .badge-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--good);
    animation: bcGlow 2s ease infinite;
    flex-shrink: 0;
  }

  /* H1 */
  .hero-h1 {
    font-family: var(--font-disp);
    font-weight: 700;
    font-size: clamp(34px, 5.5vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0;
    max-width: 16ch;
    text-wrap: balance;
    color: var(--text);
  }

  .gradient-text {
    background: linear-gradient(90deg, var(--accent), #ffb347, var(--accent));
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: bcSweep 5s linear infinite;
  }

  /* Subtitle */
  .hero-sub {
    font-size: clamp(15px, 1.6vw, 18px);
    color: var(--dim);
    max-width: 48ch;
    line-height: 1.5;
    margin: 18px 0 28px 0;
    text-wrap: pretty;
  }

  .hero-sub strong {
    color: var(--text);
    font-style: normal;
    font-weight: 600;
  }

  /* CTA row */
  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* Stats */
  .hero-stats {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
    margin-top: 36px;
  }

  .stat-val {
    display: block;
    font-family: var(--font-disp);
    font-weight: 700;
    font-size: 24px;
    color: var(--text);
  }

  .stat-label {
    display: block;
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.02em;
  }

  /* ── Steps section ── */
  .steps-section {
    padding: 26px 0;
  }

  .section-eyebrow {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 600;
    margin: 0 0 6px 0;
  }

  .section-h2 {
    font-family: var(--font-disp);
    font-weight: 700;
    font-size: clamp(22px, 2.5vw, 28px);
    letter-spacing: -0.02em;
    margin: 0 0 22px 0;
    color: var(--text);
  }

  .steps-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }

  .step-card {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 20px;
    overflow: hidden;
  }

  .step-num {
    position: absolute;
    top: -12px;
    right: 6px;
    font-family: var(--font-disp);
    font-weight: 700;
    font-size: 64px;
    color: var(--track);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }

  .step-chip--0 {
    --chip: var(--seg-0);
  }
  .step-chip--1 {
    --chip: var(--seg-1);
  }
  .step-chip--2 {
    --chip: var(--seg-2);
  }
  .step-chip--3 {
    --chip: var(--seg-3);
  }

  .step-chip {
    color: var(--chip);
    background: color-mix(in srgb, var(--chip) 16%, transparent);
    position: relative;
    display: flex;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .step-title {
    position: relative;
    font-family: var(--font-disp);
    font-weight: 700;
    font-size: 17px;
    margin: 0 0 6px 0;
    color: var(--text);
  }

  .step-body {
    position: relative;
    font-size: 13px;
    color: var(--dim);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Features section ── */
  .features-section {
    padding: 26px 0;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .feat-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.15s;
  }

  .feat-card:hover {
    border-color: var(--dim);
  }

  .feat-icon {
    display: flex;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    align-items: center;
    justify-content: center;
    background: var(--accent-soft);
    color: var(--accent);
    flex-shrink: 0;
  }

  .feat-title {
    font-family: var(--font-disp);
    font-weight: 600;
    font-size: 15px;
    margin: 0;
    color: var(--text);
  }

  .feat-body {
    font-size: 12.5px;
    color: var(--dim);
    line-height: 1.5;
    margin: 0;
  }

  /* ── CTA section ── */
  .btn-dark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: 13px;
    background: #0b1220;
    color: #fff;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .btn-dark:hover {
    opacity: 0.88;
  }

  .cta-section {
    padding: 26px 0;
  }

  .cta-banner {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    padding: 40px 44px;
    background: linear-gradient(120deg, var(--accent), #ff4d6d);
    color: #fff;
  }

  .cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      60% 120% at 90% 10%,
      rgba(255, 255, 255, 0.25),
      transparent 60%
    );
    pointer-events: none;
  }

  .cta-content {
    position: relative;
  }

  .cta-h2 {
    font-family: var(--font-disp);
    font-weight: 700;
    font-size: clamp(22px, 2.5vw, 28px);
    letter-spacing: -0.02em;
    margin: 0 0 8px 0;
    color: #fff;
  }

  .cta-sub {
    font-size: 15px;
    opacity: 0.92;
    margin: 0 0 20px 0;
    max-width: 44ch;
    color: #fff;
  }

  /* ── Tagline ── */
  .tagline {
    text-align: center;
    padding: 26px 0 10px 0;
    margin: 0;
    font-size: 12px;
    color: var(--faint);
  }

  /* ── Responsive ── */
  @media (max-width: 700px) {
    /* belt-and-braces guard against sideways scroll (clip keeps sticky nav) */
    :global(body.landing) {
      overflow-x: clip;
    }

    .hero {
      position: relative;
      overflow: hidden;
    }

    .hero-inner {
      padding-top: 12px;
      padding-bottom: 26px;
    }

    /* drop the small decorative floats… */
    .float-emoji,
    .float-svg {
      display: none;
    }

    /* …but keep the big neon pour as a faint backdrop peeking from the right */
    .float-svg-hero {
      display: block !important;
      top: auto !important;
      bottom: -6% !important;
      right: -30% !important;
      left: auto !important;
      opacity: 0.16 !important;
      z-index: 0;
    }

    .steps-section,
    .features-section,
    .cta-section {
      padding: 8px 0 18px 0;
    }

    .steps-grid {
      grid-template-columns: 1fr;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .cta-banner {
      padding: 24px 20px;
    }
  }
</style>
