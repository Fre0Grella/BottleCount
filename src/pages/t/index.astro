---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TicketScreen from '../../components/TicketScreen.vue';

// A ticket is one guest's, carried in the link; nothing here to index.
---

<BaseLayout title="Your ticket · BottleCount" noindex>
  <!--
    Every ticket is this one page. The ticket itself is in the URL fragment
    (`/t/#t=…`), which never reaches a server, so unlike `/i/<slug>` this
    needs no Pages Function to route it — see src/lib/ticketLink.ts.
  -->
  <TicketScreen client:only="vue" />
</BaseLayout>
