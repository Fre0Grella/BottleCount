---
import '../../styles/theme.css';
import TicketScreen from '../../components/TicketScreen.vue';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your ticket · BottleCount</title>
    <!-- A ticket is one guest's, carried in the link; nothing here to index. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={`${base}faviconDark.svg`} />
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem('bc-theme') || 'dark';
    </script>
  </head>
  <body
    style="margin:0;padding:0;background:var(--bg);color:var(--text);font-family:var(--font-body);min-height:100dvh"
  >
    <!--
      Every ticket is this one page. The ticket itself is in the URL fragment
      (`/t/#t=…`), which never reaches a server, so unlike `/i/<slug>` this
      needs no Pages Function to route it — see src/lib/ticketLink.ts.
    -->
    <TicketScreen client:only="vue" />
  </body>
</html>
