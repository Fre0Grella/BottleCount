---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { APP_URL } from '../../lib/links';
---

<BaseLayout title="Signing you in — BottleCount" bodyClass="centred">
  <Fragment slot="head">
    <!--
      Where Google sends the user once the Worker has set the session cookie.
      It is a static page rather than a Worker route so the cookie is already in
      the browser by the time anything here runs; all that is left is to get out
      of the way.
    -->
    <meta http-equiv="refresh" content={`2;url=${APP_URL}`} />
  </Fragment>

  <div class="signin">
    <div class="signin__title">You're in.</div>
    <div class="signin__note">Taking you back to your parties…</div>
    <a class="signin__link" href={APP_URL}>Continue</a>
  </div>
</BaseLayout>

<script>
  import { APP_URL } from '../../lib/links';
  import { safeSession } from '../../lib/safeStorage';

  // A co-organiser invitation sends people through sign-in and expects them
  // back on the invitation. The meta refresh above is the fallback for when
  // this script does not run at all.
  const back = safeSession.get('bc-after-signin');
  safeSession.remove('bc-after-signin');
  // Same-origin paths only: an absolute URL here would make the sign-in flow
  // an open redirect.
  window.location.replace(
    back && back.startsWith('/') && !back.startsWith('//') ? back : APP_URL,
  );
</script>

<style>
  .signin {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .signin__title {
    font-family: var(--font-disp);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.01em;
  }
  .signin__note {
    font-size: 13px;
    color: var(--dim);
  }
  .signin__link {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }
</style>
