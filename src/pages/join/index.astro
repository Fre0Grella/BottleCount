---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JoinScreen from '../../screens/JoinScreen.vue';

// Anyone with this URL can edit a party; it has no business in an index.
---

<BaseLayout title="Co-organise a party · BottleCount" noindex>
  <!--
    One page serves every invitation, with the token in the path. Same
    arrangement as /i: `functions/join/[[token]].ts` rewrites the space onto
    this asset, because tokens are minted at runtime and `getStaticPaths`
    cannot know them.
  -->
  <JoinScreen client:only="vue" />
</BaseLayout>
