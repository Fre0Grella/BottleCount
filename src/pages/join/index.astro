---
import '../../styles/theme.css';
import JoinScreen from '../../components/JoinScreen.vue';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Co-organise a party · BottleCount</title>
    <!-- Anyone with this URL can edit a party; it has no business in an index. -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href={`${base}faviconDark.svg`} />
    <script is:inline>
      document.documentElement.dataset.theme =
        localStorage.getItem('bc-theme') || 'dark';
    </script>
  </head>
  <body
    style="margin:0;padding:0;background:var(--bg);color:var(--text);font-family:var(--font-body);min-height:100dvh"
  >
    <!--
      One page serves every invitation, with the token in the path. Same
      arrangement as /i: `functions/join/[[token]].ts` rewrites the space onto
      this asset, because tokens are minted at runtime and `getStaticPaths`
      cannot know them.
    -->
    <JoinScreen client:only="vue" />
  </body>
</html>
