---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InviteScreen from '../../components/InviteScreen.vue';

// Invite links are private by nature: anyone with the URL can read the
// party's name, date and venue, so they have no business in a search index.
---

<BaseLayout title="You're invited · BottleCount" noindex>
  <!--
    One page serves every invite. The slug lives in the path (`/i/<slug>`),
    which a static build cannot route on its own, so `functions/i/[[slug]].ts`
    rewrites the whole `/i/*` space onto this asset and the component reads
    the slug back off `location.pathname`.

    The alternative — `getStaticPaths` — cannot work here: the slugs are
    created by guests' hosts at runtime, long after the build.
  -->
  <InviteScreen client:only="vue" />
</BaseLayout>
