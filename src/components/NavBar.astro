---
const { active } = Astro.props as { active: string };
const base = import.meta.env.BASE_URL;

const links = [
  { href: base, label: 'Home', key: 'home' },
  { href: `${base}app`, label: 'App', key: 'app' },
  { href: `${base}docs`, label: 'Docs', key: 'docs' },
];
---

<nav class="nav">
  <a class="nav-brand" href={base}>
    <img
      src={`${base}logoDark.svg`}
      alt=""
      width="28"
      height="28"
      style="display:block;flex-shrink:0;"
    />
    BottleCount
  </a>
  <!-- Desktop links -->
  <div class="nav-links">
    {
      links.map((l) => (
        <a class={`nav-link${active === l.key ? ' active' : ''}`} href={l.href}>
          {l.label}
        </a>
      ))
    }
  </div>
</nav>

<nav class="nav-bottom" aria-label="Primary">
  {
    links.map((l) => (
      <a
        class={`nav-bottom__link${active === l.key ? ' active' : ''}`}
        href={l.href}
      >
        <span class="nav-bottom__label">{l.label}</span>
      </a>
    ))
  }
</nav>
