---
import BaseLayout from './BaseLayout.astro';
import NavBar from '../components/site/NavBar.astro';
import AppFooter from '../components/site/AppFooter.vue';

/** A legal page (privacy, terms): its heading, its date, then the text. */
interface Props {
  title: string;
  updated: string;
}

const { title, updated } = Astro.props;
---

<BaseLayout title={`${title} · BottleCount`} canonical>
  <NavBar />
  <main class="legal">
    <article class="legal__page">
      <h1>{title}</h1>
      <p class="legal__updated">Last updated: {updated}</p>
      <slot />
    </article>
  </main>
  <AppFooter />
</BaseLayout>

<style>
  .legal {
    padding: 16px 20px 48px;
  }
  .legal__page {
    max-width: 760px;
    margin: 0 auto;
    line-height: 1.7;
    font-size: 14px;
    color: var(--dim);
  }
  .legal__page :global(h1) {
    font-family: var(--font-disp);
    font-size: 1.9rem;
    letter-spacing: -0.02em;
    color: var(--text);
    margin: 0 0 0.25rem 0;
  }
  .legal__page :global(h2) {
    font-family: var(--font-disp);
    font-size: 1.15rem;
    margin-top: 1.75rem;
    color: var(--text);
  }
  .legal__updated {
    color: var(--faint);
    font-size: 0.8rem;
    margin-bottom: 1.5rem;
  }
  .legal__page :global(a) {
    color: var(--accent);
    text-decoration: none;
  }
  .legal__page :global(a:hover) {
    text-decoration: underline;
  }
  .legal__page :global(ul) {
    padding-left: 1.25rem;
  }
  .legal__page :global(strong) {
    color: var(--text);
  }
</style>
